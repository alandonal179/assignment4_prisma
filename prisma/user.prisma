model User{
    id String @id @default(uuid())
    name String @db.VarChar(255)
    email String @unique
    password String
    activeStatus ActiveStatus @default(ACTIVE) 
    role Role @default(Customer)
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

enum ActiveStatus{
    ACTIVE
    BLOCKED
}

enum Role{
    Customer
    Provider
    Admin
}